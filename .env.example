# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Persistence URLs (Local Docker Compose Services)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db
MONGO_URI=mongodb://localhost:27017/portfolio_db
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Notification Webhooks & Secrets
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
ADMIN_SECRET_KEY=change_this_in_production