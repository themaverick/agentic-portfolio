# Server Configuration (Vercel Production Environment Variables)
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=https://your-username.github.io

# LLM Provider
GEMINI_API_KEY=your_production_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Persistence URLs (Production Neon PostgreSQL & Cloud Services)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx.neon.tech/neondb?sslmode=require
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio_db
REDIS_URL=rediss://default:password@your-upstash-redis.upstash.io:6379
KAFKA_BOOTSTRAP_SERVERS=

# Notification Webhooks & Secrets
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
ADMIN_SECRET_KEY=strong_random_production_secret_key
